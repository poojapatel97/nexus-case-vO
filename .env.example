# ============================================================================
# The Nexus Case - Environment Variables Template
# Amazon Aurora PostgreSQL Configuration
# ============================================================================

# AWS Aurora PostgreSQL Connection Parameters
PGHOST=your-cluster.abc123.us-east-1.rds.amazonaws.com
PGPORT=5432
PGUSER=iam_db_user
PGDATABASE=nexus_case
PGSSLMODE=require

# AWS Identity and Access Management
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/vercel-nexus-case
AWS_ACCOUNT_ID=123456789012
AWS_RESOURCE_ARN=arn:aws:rds:us-east-1:123456789012:dbuser:resource-id/iam_db_user

# Prisma Configuration (Required for migrations and schema introspection)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://iam_db_user:password@your-cluster.abc123.us-east-1.rds.amazonaws.com:5432/nexus_case?sslmode=require
DIRECT_DATABASE_URL=postgresql://iam_db_user:password@your-cluster.abc123.us-east-1.rds.amazonaws.com:5432/nexus_case?sslmode=require

# Node Environment
NODE_ENV=development

# ============================================================================
# Setup Instructions:
#
# 1. Set PGHOST to your Aurora cluster endpoint
# 2. Set AWS_REGION to your Aurora region
# 3. Set AWS_ROLE_ARN to your OIDC-enabled IAM role
# 4. For local development, provide a DATABASE_URL with credentials
# 5. For Vercel deployment, use OIDC authentication (credentials auto-provided)
#
# See docs/AURORA_SETUP.md for detailed configuration instructions.
# ============================================================================
